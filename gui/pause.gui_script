-- 💾 Resuelve el mensaje de Importar/Exportar (GOTCHA #37): save_manager
-- devuelve CLAVES neutras ("exported_html5"...) y aquí se traducen con
-- general_text → M.save. detail es el parámetro opcional de %s (ruta/error).
local function resolve_save_msg(self, key, detail)
	local save_txt = (text_loader.load("general", self.current_lang) or {}).save or {}
	if key == "exported_html5" then
		return save_txt.exported_html5 or "Partida exportada como .json (descargada en el navegador)"
	elseif key == "exported_desktop" then
		return string.format(save_txt.exported_desktop or "Partida exportada en: %s", detail or "")
	elseif key == "export_error" then
		return save_txt.export_error or "Error al exportar la partida"
	elseif key == "import_ok" then
		return save_txt.import_ok or "Partida importada correctamente"
	elseif key == "import_read_error" then
		return save_txt.import_read_error or "No se pudo leer el archivo de guardado"
	elseif key == "import_json_error" then
		return string.format(save_txt.import_json_error or "Error al leer el JSON: %s", detail or "")
	elseif key == "import_invalid_format" then
		return save_txt.import_invalid_format or "El archivo de guardado no es válido"
	elseif key == "import_unsupported_version" then
		return save_txt.import_unsupported_version or "La version de la partida no es compatible"
	end
	-- Fallback: clave sin traducir
	return key
end

function on_input(self, action_id, action)

	-- ═══════════════════════════════════════════════════════
	-- TECLA P → TOGGLE de pausa: abre si está cerrada, cierra si está abierta
	-- (mismo comportamiento que ESC para cerrar; antes la P se "tragaba" la
	-- pulsación sin hacer nada con la pausa ya abierta).
	-- ═══════════════════════════════════════════════════════
	if action_id == hash("key_p") and action.pressed then
		if self.is_paused then
			hide_pause(self)
			return true
		elseif self.pause_enabled then
			show_pause(self)
			return true
		end
	end

	-- ═══════════════════════════════════════════════════════
	-- TECLA ESC → desactivar pausa (sólo si está activa)
	-- ═══════════════════════════════════════════════════════
	if action_id == hash("key_esc") and action.pressed then
		if self.is_paused then
			hide_pause(self)
			return true
		end
		-- Si no está en pausa, dejamos que ESC llegue a otros
		-- scripts (player, exhibition, etc.)
		return false
	end

	-- ═══════════════════════════════════════════════════════
	-- SI NO ESTÁ EN PAUSA → ignorar el resto del input
	-- ═══════════════════════════════════════════════════════
	if not self.is_paused then
		return false
	end

	-- ═══════════════════════════════════════════════════════
	-- 🖱️ HOVER (action_id == nil para movimientos del ratón)
	-- ═══════════════════════════════════════════════════════
	if action_id == nil then
		local hovering_resume = gui.pick_node(self.btn_resume, action.x, action.y)
		if hovering_resume ~= self.resume_hover then
			self.resume_hover = hovering_resume
			animate_resume_hover(self, hovering_resume)
		end

		-- Hover del botón de idioma
		local hovering_lan = gui.pick_node(self.btn_lan, action.x, action.y)
			or gui.pick_node(self.lan_title, action.x, action.y)
		animate_lan_hover(self, hovering_lan)

		-- Hover de la opción del desplegable (sólo si está abierto)
		if self.lang_dropdown_open then
			local hovering_opt = gui.pick_node(self.lan_option_01, action.x, action.y)
			animate_option_hover(self, hovering_opt)
		else
			animate_option_hover(self, false)
		end

		-- Hover de los botones de importar/exportar
		local hovering_import = gui.pick_node(self.btn_import, action.x, action.y)
		if hovering_import ~= self.import_hover then
			self.import_hover = hovering_import
			gui.cancel_animations(self.btn_import, gui.PROP_COLOR)
			gui.animate(self.btn_import, gui.PROP_COLOR, hovering_import and BTN_COLOR_HOVER or BTN_COLOR_NORMAL, gui.EASING_OUTQUAD, BTN_HOVER_DURATION)
		end

		local hovering_export = gui.pick_node(self.btn_export, action.x, action.y)
		if hovering_export ~= self.export_hover then
			self.export_hover = hovering_export
			gui.cancel_animations(self.btn_export, gui.PROP_COLOR)
			gui.animate(self.btn_export, gui.PROP_COLOR, hovering_export and BTN_COLOR_HOVER or BTN_COLOR_NORMAL, gui.EASING_OUTQUAD, BTN_HOVER_DURATION)
		end

		-- Hover de los botones de volumen
		local hovering_down = gui.pick_node(self.btn_vol_down, action.x, action.y)
		animate_vol_down_hover(self, hovering_down)

		local hovering_up = gui.pick_node(self.btn_vol_up, action.x, action.y)
		animate_vol_up_hover(self, hovering_up)

		-- 🎛️ Hover de los botones de efectos
		local hovering_sfx_down = gui.pick_node(self.btn_sfx_down, action.x, action.y)
		animate_sfx_down_hover(self, hovering_sfx_down)

		local hovering_sfx_up = gui.pick_node(self.btn_sfx_up, action.x, action.y)
		animate_sfx_up_hover(self, hovering_sfx_up)

		-- 🌡️ Hover del botón de unidades de temperatura
		local hovering_units = gui.pick_node(self.btn_units, action.x, action.y)
		animate_units_hover(self, hovering_units)

		-- 🖥️ Hover del botón del overlay FPS
		local hovering_fps = gui.pick_node(self.btn_fps, action.x, action.y)
		animate_fps_hover(self, hovering_fps)

		return true
	end

	-- ═══════════════════════════════════════════════════════
	-- 👆 CLICS (solo cuando el juego está pausado)
	-- ═══════════════════════════════════════════════════════
	if action_id == hash("touch") and action.pressed then
		-- Botón de reanudar
		if gui.pick_node(self.btn_resume, action.x, action.y) then
			hide_pause(self)
			return true
		end

		-- Si el desplegable está abierto, option_01 se comprueba primero
		if self.lang_dropdown_open then
			if gui.pick_node(self.lan_option_01, action.x, action.y) then
				local new_lang = (self.current_lang == "es") and "en" or "es"
				game_state.set_global("language", new_lang)
				self.current_lang = new_lang
				gui.set_text(self.lan_title, LANG_LABELS[new_lang])
				local other = (new_lang == "es") and "en" or "es"
				gui.set_text(self.lan_option_text, LANG_LABELS[other])
				-- Actualizar textos al nuevo idioma
				local new_texts = text_loader.load("general", new_lang)
				gui.set_text(self.text_info, new_texts.ui.label_pause or "Juego en pausa")
				gui.set_text(self.text_language, new_texts.ui.label_language or "Idioma")
				gui.set_text(self.text_file_game, new_texts.ui.label_file_game or "Partida")
				gui.set_text(self.text_vol_label, new_texts.ui.label_volume or "Música")
				gui.set_text(self.text_sfx_label, new_texts.ui.label_sfx or "Efectos de sonido")
				gui.set_text(self.text_units_label, new_texts.ui.label_temp_units or "Unidades")
				gui.set_text(self.text_fps_label, new_texts.ui.label_fps or "Mostrar FPS")
				refresh_fps(self)
				self.lang_dropdown_open = false
				gui.set_enabled(self.lan_header_bg, false)
				gui.set_enabled(self.lan_option_01, false)
				gui.set_enabled(self.lan_option_text, false)
				dprint("[Pause] 🌐 Idioma cambiado a: " .. LANG_LABELS[new_lang])
				return true
			end
		end

		-- Botón de idioma → toggle desplegable
		if gui.pick_node(self.btn_lan, action.x, action.y)
		   or gui.pick_node(self.lan_title, action.x, action.y) then
			self.lang_dropdown_open = not self.lang_dropdown_open
			gui.set_enabled(self.lan_header_bg, self.lang_dropdown_open)
			gui.set_enabled(self.lan_option_01, self.lang_dropdown_open)
			gui.set_enabled(self.lan_option_text, self.lang_dropdown_open)
			return true
		end

		-- Si el desplegable seguía abierto y no se pulsó nada → cerrar
		if self.lang_dropdown_open then
			self.lang_dropdown_open = false
			gui.set_enabled(self.lan_header_bg, false)
			gui.set_enabled(self.lan_option_01, false)
			gui.set_enabled(self.lan_option_text, false)
			return true
		end

		-- ═══════════════════════════════════════════════════════
		-- 🎚️ BOTONES DE VOLUMEN
		-- ═══════════════════════════════════════════════════════
		if gui.pick_node(self.btn_vol_down, action.x, action.y) then
			set_volume(self, self.volume - 0.1)
			return true
		end

		if gui.pick_node(self.btn_vol_up, action.x, action.y) then
			set_volume(self, self.volume + 0.1)
			return true
		end

		-- 🎛️ Botones de efectos (grupo sfx)
		if gui.pick_node(self.btn_sfx_down, action.x, action.y) then
			set_sfx_volume(self, self.sfx_volume - 0.1)
			return true
		end

		if gui.pick_node(self.btn_sfx_up, action.x, action.y) then
			set_sfx_volume(self, self.sfx_volume + 0.1)
			return true
		end

		-- Clic en el botón de sonido → toggle mute
		if gui.pick_node(self.btn_sound, action.x, action.y) then
			if self.volume > 0 then
				set_volume(self, 0)
			else
				set_volume(self, 1.0)
			end
			return true
		end

		-- Clic en el botón de mute de EFECTOS → toggle (mismo comportamiento
		--    que el de música: silenciar/restaurar al 100%)
		if gui.pick_node(self.btn_sfx_sound, action.x, action.y) then
			if self.sfx_volume > 0 then
				set_sfx_volume(self, 0)
			else
				set_sfx_volume(self, 1.0)
			end
			return true
		end

		-- 🌡️ Botón de unidades de temperatura (°C ↔ °F). Preferencia del
		--    jugador, persistida en game_state (temp_units); el HUD la aplica
		--    solo a la visualización (la simulación sigue en °C).
		if gui.pick_node(self.btn_units, action.x, action.y) then
			self.temp_units = (self.temp_units == "c") and "f" or "c"
			game_state.set_global("temp_units", self.temp_units)
			refresh_units(self)
			dprint("[Pause] 🌡️ Unidad de temperatura: " .. ((self.temp_units == "f") and "°F" or "°C"))
			return true
		end

		-- 🖥️ Botón del overlay FPS (Sí ↔ No). Solo persiste en game_state
		--    (fps_overlay): el HUD lo lee por polling en su update() (mismo
		--    patrón que temp_units). NO se envía mensaje al HUD: pause vive en
		--    bootstrap:/gui_library y el HUD en level_01 (/gui#hud) — una ruta
		--    "/gui#hud" desde bootstrap no resuelve (el /gui solo existe con
		--    level_01 cargado) → ERROR de dispatch.
		if gui.pick_node(self.btn_fps, action.x, action.y) then
			local enabled = game_state.get_global("fps_overlay")
			if enabled == nil then enabled = true end
			enabled = not enabled
			game_state.set_global("fps_overlay", enabled)
			refresh_fps(self)
			dprint("[Pause] 🖥️ Overlay FPS: " .. (enabled and "activado" or "desactivado"))
			return true
		end

		-- ═══════════════════════════════════════════════════════
		-- 💾 BOTONES DE IMPORTAR / EXPORTAR
		-- ═══════════════════════════════════════════════════════

		if gui.pick_node(self.btn_export, action.x, action.y) then
			local ok, key, detail = save_manager.export_save()
			gui.set_text(self.text_info, resolve_save_msg(self, key, detail))
			dprint("[Pause] Export: " .. tostring(key))
			return true
		end

		if gui.pick_node(self.btn_import, action.x, action.y) then
			local save_txt = (text_loader.load("general", self.current_lang) or {}).save or {}
			gui.set_text(self.text_info, save_txt.select_file or "Selecciona un archivo .json...")
			save_manager.request_import(function(json_str)
				local ok, key, detail = save_manager.process_import(json_str)
				gui.set_text(self.text_info, resolve_save_msg(self, key, detail))
				dprint("[Pause] Import result: " .. tostring(key))
			end)
			return true
		end

		-- Clic fuera de cualquier botón → ignorar (no cerrar)
		return true
	end

	-- Consumir cualquier otro input mientras estamos en pausa
	return true
end

-- ═══════════════════════════════════════════════════════
-- 🧹 FINAL
-- ═══════════════════════════════════════════════════════

function final(self)
	msg.post(".", "release_input_focus")

	-- Asegurar que el juego se reanuda si el menú estaba abierto
	if self.is_paused then
		hide_pause(self)
	end
end
