# 📱 Multi-touch (controles táctiles móvil/HTML5, ver MOBILE_CONTROLS_PLAN.md)
# ⚠️ Regla crítica (manual oficial Defold "Mouse and touch input"):
#    el action del multi-touch NO puede ser el mismo que el de MOUSE_BUTTON_1/LEFT
#    (pisaría el single-touch). Por eso se usa el nombre único "touch_multi".
#    Los touch points llegan a on_input como action.touch (tabla 1..N) con
#    id/x/y/screen_x/screen_y/pressed/released.
touch_trigger {
  input: TOUCH_MULTI
  action: "touch_multi"
}
# 🖥️ Overlay de FPS (debug temporal): toggle con la tecla F (lo gestiona
#    gui/hud.gui_script). Para que el overlay no aparezca nunca:
#    FPS_START_VISIBLE = false en gui/hud.gui_script.
#    ⚠️ Letra a propósito: las teclas F* (F3, F5, F11, F12…) las intercepta el
#    navegador en HTML5 y nunca llegan al juego.
key_trigger {
  input: KEY_F
  action: "key_f"
}
