-- features/props/kit_stamina.script
-- ═══════════════════════════════════════════════════════
-- ⚡ MÁQUINA DE ENERGÍA (Kit_stamina)
-- ═══════════════════════════════════════════════════════
--
--   a) On hover: Tintado del sprite (iluminar)
--   b) On clic:
--      - Si stamina < 100%: recupera al 100%, reproduce pick_up.sound
--      - Si stamina = 100%: muestra alerta con hint_energy
--
-- Licencia: GPL-3.0-only (Ver LICENSE en la raíz)
-- Versión de Defold: 1.13
-- Última actualización: 2026-08-15
-- ═══════════════════════════════════════════════════════

local game_state = require "main.game_state"
local text_loader = require "main.text_loader"
local config = require "main.config"

-- 🔧 DEBUG granular (sistema make_log, ver main/config.lua):
local DEBUG_KIT_STAMINA = false
local dprint = config.make_log(DEBUG_KIT_STAMINA)

-- 🌐 Recarga los hints localizados (text_alert). Definida ANTES de init para
--    que init y el callback de idioma la capturen como upvalue (GOTCHA #1).
local function load_hints(self)
	local general_texts = text_loader.load("general") or {}
	self.energy_hint = (general_texts.tutorials and general_texts.tutorials.hint_energy)
		or "You can restore your energy here when you need it"
end

function init(self)
	self.sprite_url = msg.url(nil, nil, "sprite")

	load_hints(self)

	-- 🌐 Recargar hints si el idioma cambia en caliente
	game_state.register_callback("language", function(var_name, old_lang, new_lang)
		load_hints(self)
		dprint("[kit_stamina] Hints recargados por cambio de idioma a: " .. tostring(new_lang))
	end)
end

local function set_hover_state(self, is_hovered)
	-- Solo tintado del sprite (sin escalado) en hover
	if go.exists(self.sprite_url) then
		if is_hovered then
			go.animate(self.sprite_url, "tint", go.PLAYBACK_ONCE_FORWARD, vmath.vector4(1.3, 1.3, 1.2, 1.0), go.EASING_OUTCUBIC, 0.12)
		else
			go.animate(self.sprite_url, "tint", go.PLAYBACK_ONCE_FORWARD, vmath.vector4(1.0, 1.0, 1.0, 1.0), go.EASING_OUTCUBIC, 0.12)
		end
	end
end

function on_message(self, message_id, message, sender)
	if message_id == hash("mouse_hover") then
		set_hover_state(self, message.enter)

	elseif message_id == hash("interact") then
		local stamina = tonumber(game_state.get_global("stamina") or 100)

		if stamina < 100 then
			-- Recuperar energía al máximo
			game_state.set_global("stamina", 100)
			sound.play("#pick_up")				dprint("[kit_stamina] Energía restaurada al 100%")
		else
			-- Energía ya al máximo: mostrar hint
			msg.post("/gui#hud", "show_alert", {
				text = self.energy_hint
			})				dprint("[kit_stamina] Energía al máximo: mostrando hint")
		end
	end
end
