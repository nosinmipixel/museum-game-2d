-- features/props/spray_spawn_container.script
-- ═══════════════════════════════════════════════════════
-- 🏗️ CONTENEDOR DE SPAWN DE SPRAY CANS
-- ═══════════════════════════════════════════════════════
--
--   Gestiona la creación y reposición de spray_cans en
--   sus puntos de spawn hijos (spray_spawn_01..N).
--
--   Detecta los hijos dinámicamente por naming convention:
--     spray_spawn_01, spray_spawn_02, ..., spray_spawn_NN
--
--   Se comunica con los spray_cans via spray_spawn_state.lua
--   (módulo compartido) en lugar de factory.create properties.
--
--   Al iniciar:
--     1. Escanea hijos spray_spawn_XX y guarda sus posiciones
--     2. Selecciona MAX_ACTIVE puntos aleatorios
--     3. Crea un spray_can en cada punto seleccionado
--
--   Al recoger un spray_can (spray_picked_up):
--     1. Marca el spawn point como libre (usando spawn_index)
--     2. Si hay menos de MAX_ACTIVE activos, crea uno nuevo
--
-- Licencia: GPL-3.0-only (Ver LICENSE en la raíz)
-- Versión de Defold: 1.13
-- Última actualización: 2026-08-15
-- ═══════════════════════════════════════════════════════

local spray_state = require "main.spray_spawn_state"
local config = require "main.config"

-- ⚙️ CONFIGURACIÓN
local MAX_ACTIVE = 3  -- Máximo de spray_cans activos simultáneamente
-- 🔧 DEBUG granular: true = loguea cuando M.DEBUG esté activo; false = silenciado
local DEBUG_SPRAY_SPAWN = false
local dprint = config.make_log(DEBUG_SPRAY_SPAWN)

-- ⚠️ GOTCHA #1 (docs/DEV_GOTCHAS.md): initialize_spawns y spawn_spray_can_at_index
-- están definidas MÁS ABAJO pero son llamadas desde update()/on_message() o desde
-- initialize_spawns. Forward declaration: los callers las capturan como upvalues
-- y las definiciones posteriores 'function X(self)' asignan a estos locales.
-- (discover_spawn_points y find_free_spawn_index ya están antes que sus callers:
--  se convierten a 'local function' directo.)
local initialize_spawns
local spawn_spray_can_at_index

-- ═══════════════════════════════════════════════════════

function init(self)
	-- Almacenar la URL en el módulo compartido para que los spray_cans
	-- puedan notificar al recogerse (en lugar de variable global).
	spray_state.container_url = msg.url()

	self.spawn_points = {}  -- { position=v3, occupied=bool }
	self.active_count = 0
	self.is_initialized = false
end

function update(self, dt)
	if not self.is_initialized then
		self.is_initialized = true
		initialize_spawns(self)
	end
end

-- ═══════════════════════════════════════════════════════
-- 🔍 DETECCIÓN DINÁMICA DE PUNTOS DE SPAWN
-- ═══════════════════════════════════════════════════════
-- Busca hijos con naming spray_spawn_01..spray_spawn_NN
-- usando go.exists() + go.get_position()
-- ═══════════════════════════════════════════════════════

local function discover_spawn_points(self)
	self.spawn_points = {}

	for i = 1, 99 do  -- límite generoso, se rompe al primer hueco
		local name = "spray_spawn_" .. string.format("%02d", i)
		if go.exists(name) then
			local pos = go.get_position(name)
			table.insert(self.spawn_points, {
				position = pos,
				occupied = false
			})
			dprint("[spray_spawn_container] Encontrado: " .. name)
		else
			-- Asumimos que no hay más spawn points después del primer hueco
			break
		end
	end
end

-- ═══════════════════════════════════════════════════════
-- 🚀 INICIALIZACIÓN DE SPAWNS
-- ═══════════════════════════════════════════════════════

function initialize_spawns(self)
	-- Detectar dinámicamente los puntos de spawn
	discover_spawn_points(self)

	if #self.spawn_points == 0 then
		print("[spray_spawn_container] ⚠️ No se encontraron puntos de spawn (spray_spawn_01..NN)")
		return
	end

	dprint("[spray_spawn_container] Detectados " .. #self.spawn_points .. " puntos de spawn")

	-- Seleccionar aleatoriamente MAX_ACTIVE puntos (o todos si hay menos)
	local num_to_spawn = math.min(MAX_ACTIVE, #self.spawn_points)
	local selected_indices = {}

	while #selected_indices < num_to_spawn do
		local idx = math.random(1, #self.spawn_points)
		local already_selected = false
		for _, s in ipairs(selected_indices) do
			if s == idx then
				already_selected = true
				break
			end
		end
		if not already_selected then
			table.insert(selected_indices, idx)
		end
	end

	-- Crear spray_cans en los puntos seleccionados
	for _, idx in ipairs(selected_indices) do
		local ok = spawn_spray_can_at_index(self, idx)
		if ok then
			self.spawn_points[idx].occupied = true
			self.active_count = self.active_count + 1
		end
	end

	dprint("[spray_spawn_container] Creados " .. self.active_count .. "/" .. MAX_ACTIVE .. " spray_cans activos")
end

-- ═══════════════════════════════════════════════════════
-- 🎯 CREAR UN SPRAY_CAN EN UN ÍNDICE DE SPAWN
-- ═══════════════════════════════════════════════════════

function spawn_spray_can_at_index(self, spawn_idx)
	local spawn = self.spawn_points[spawn_idx]

	-- 🪺 Fase 2 (docs/plans/archive/NEST_SYSTEM_PLAN.md): tirada de rareza al crear/reponer un
	--    bote — ¿spray normal o bote de insecticida especial? La probabilidad
	--    vive en main/config.lua → M.balance.nest.insecticide_chance (fallback
	--    0.18 si la clave se borrara). Aplica por igual al spawn inicial y a
	--    cada reposición (ambos pasan por aquí).
	-- 🔧 DEBUG (config.DEBUG_ALL_INSECTICIDE): true → TODOS los botes son de
	--    insecticida, sin tirada (para probar el sistema de nidos).
	local nest_cfg = (config.balance and config.balance.nest) or {}
	local is_insecticide = config.DEBUG_ALL_INSECTICIDE
		or (math.random() < (nest_cfg.insecticide_chance or 0.18))

	-- Escribir datos en el módulo compartido ANTES de factory.create
	-- factory.create es síncrono: el init() del spray_can se ejecuta
	-- inmediatamente, lee pending_spawn y lo limpia.
	spray_state.pending_spawn = {
		index = spawn_idx,
		position = spawn.position,
		is_insecticide = is_insecticide
	}

	local ok, err = pcall(factory.create, "#spray_can_factory", spawn.position)
	if ok then
		dprint("[spray_spawn_container] " .. (is_insecticide and "Insecticida" or "Spray_can") ..
		      " en spawn #" .. spawn_idx .. " (" ..
		      string.format("%.0f, %.0f", spawn.position.x, spawn.position.y) .. ")")
		return true
	else
		print("[spray_spawn_container] ⚠️ Error al crear spray_can en spawn #" .. spawn_idx .. ": " .. tostring(err))
		spray_state.pending_spawn = nil  -- limpiar por si acaso
		return false
	end
end

-- ═══════════════════════════════════════════════════════
-- 🔍 BUSCAR PUNTO DE SPAWN LIBRE
-- ═══════════════════════════════════════════════════════

local function find_free_spawn_index(self, exclude_idx)
	local free_indices = {}
	for idx, spawn in ipairs(self.spawn_points) do
		if not spawn.occupied and idx ~= exclude_idx then
			table.insert(free_indices, idx)
		end
	end

	if #free_indices == 0 then
		return nil
	end

	return free_indices[math.random(1, #free_indices)]
end

-- ═══════════════════════════════════════════════════════
-- 📩 MANEJO DE MENSAJES
-- ═══════════════════════════════════════════════════════

function on_message(self, message_id, message, sender)
	if message_id == hash("spray_picked_up") then
		local spawn_idx = message.spawn_index

		if spawn_idx and self.spawn_points[spawn_idx] then
			self.spawn_points[spawn_idx].occupied = false
			self.active_count = math.max(0, self.active_count - 1)
			dprint("[spray_spawn_container] Spray_can recogido (spawn #" .. spawn_idx .. "). Activos: " .. self.active_count)

			-- Reponer si hay menos del máximo
			if self.active_count < MAX_ACTIVE then
				local free_idx = find_free_spawn_index(self, spawn_idx)
				if free_idx then
					local ok = spawn_spray_can_at_index(self, free_idx)
					if ok then
						self.spawn_points[free_idx].occupied = true
						self.active_count = self.active_count + 1
						dprint("[spray_spawn_container] Spray_can repuesto en spawn #" .. free_idx .. ". Activos: " .. self.active_count)
					end
				else
					dprint("[spray_spawn_container] No hay puntos de spawn libres para reponer")
				end
			end
		else
			print("[spray_spawn_container] ⚠️ spawn_index inválido: " .. tostring(spawn_idx))
		end
	end
end
